{
  "expo": {
    "name": "DeenLink",
    "slug": "deenlink",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deenlink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "DeenLink recognizes your recitation to find verses and score your practice.",
        "NSMicrophoneUsageDescription": "DeenLink uses the microphone to listen to Qur\u2019an recitation for voice search and practice."
      }
    },
    "android": {
      "package": "org.deenlink.app",
      "adaptiveIcon": {
        "backgroundColor": "#06140D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7A5F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeenLink uses your location to calculate accurate prayer times and the Qibla direction."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DeenLink uses the microphone to listen to Qur\u2019an recitation for voice search and practice.",
          "speechRecognitionPermission": "DeenLink recognizes your recitation to find verses and score your practice."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0E7A5F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#06140D",
      "resizeMode": "contain"
    },
    "backgroundColor": "#06140D",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d5827da-5110-4466-be9a-b091b4b49deb"
      }
    },
    "owner": "pixel605s-team"
  }
}
