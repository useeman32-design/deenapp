{
  "expo": {
    "name": "DeenLink",
    "slug": "deenlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deenlink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.deenlink.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "DeenLink recognizes your recitation to find verses and score your practice.",
        "NSMicrophoneUsageDescription": "DeenLink uses the microphone to listen to Qur\u2019an recitation for voice search and practice."
      }
    },
    "android": {
      "package": "org.deenlink.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#06140D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7A5F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeenLink uses your location to calculate accurate prayer times and the Qibla direction."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DeenLink uses the microphone to listen to Qur\u2019an recitation for voice search and practice.",
          "speechRecognitionPermission": "DeenLink recognizes your recitation to find verses and score your practice."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0E7A5F",
          "sounds": [
            "./public/adhan/adhan1.mp3",
            "./public/adhan/adhan2.mp3",
            "./public/adhan/adhan3.mp3"
          ]
        }
      ],
      "./plugins/withAdhanFullScreen",
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./fonts/Amiri-Bold.ttf",
            "./fonts/Amiri.ttf",
            "./fonts/AntDesign.ttf",
            "./fonts/ArefRuqaa-Bold.ttf",
            "./fonts/ArefRuqaa.ttf",
            "./fonts/Entypo.ttf",
            "./fonts/EvilIcons.ttf",
            "./fonts/Feather.ttf",
            "./fonts/FontAwesome.ttf",
            "./fonts/FontAwesome5Free-Brand.ttf",
            "./fonts/FontAwesome5Free-Light.ttf",
            "./fonts/FontAwesome5Free-Regular.ttf",
            "./fonts/FontAwesome5Free-Solid.ttf",
            "./fonts/FontAwesome6_Brands.ttf",
            "./fonts/FontAwesome6_Regular.ttf",
            "./fonts/FontAwesome6_Solid.ttf",
            "./fonts/Fontisto.ttf",
            "./fonts/Foundation.ttf",
            "./fonts/Ionicons.ttf",
            "./fonts/Manrope.ttf",
            "./fonts/MaterialCommunityIcons.ttf",
            "./fonts/MaterialIcons.ttf",
            "./fonts/Octicons.ttf",
            "./fonts/Poppins-Bold.ttf",
            "./fonts/Poppins-ExtraBold.ttf",
            "./fonts/Poppins-Medium.ttf",
            "./fonts/Poppins-Regular.ttf",
            "./fonts/Poppins-SemiBold.ttf",
            "./fonts/Poppins.ttf",
            "./fonts/SimpleLineIcons.ttf",
            "./fonts/Sora.ttf",
            "./fonts/Zocial.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "."
    },
    "backgroundColor": "#06140D",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d5827da-5110-4466-be9a-b091b4b49deb"
      }
    },
    "owner": "pixel605s-team"
  }
}
